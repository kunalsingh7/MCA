        <text x="230" y="103" text-anchor="middle" font-size="11.5" font-weight="600" fill="#fff">Cache</text>
        <polygon points="167,120 293,120 313,162 147,162" fill="#3b82f6"/>
        <text x="230" y="147" text-anchor="middle" font-size="11.5" font-weight="600" fill="#fff">RAM (forgets on power off)</text>
        <polygon points="147,164 313,164 335,206 125,206" fill="#10b981"/>
        <text x="230" y="191" text-anchor="middle" font-size="11.5" font-weight="600" fill="#fff">SSD / Hard Disk (never forgets)</text>
        <line x1="372" y1="40" x2="372" y2="198" stroke="currentColor" stroke-width="2" opacity="0.5"/>
        <polygon points="372,205 367,195 377,195" fill="currentColor" opacity="0.5"/>
        <text x="384" y="60" font-size="11" fill="currentColor" opacity="0.8">fastest</text>
        <text x="384" y="76" font-size="11" fill="currentColor" opacity="0.8">smallest</text>
