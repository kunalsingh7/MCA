        <text x="384" y="192" font-size="11" fill="currentColor" opacity="0.8">biggest</text>
      </svg>`,

  "comm-cycle": `<svg viewBox="0 0 480 235" font-family="Segoe UI, system-ui, sans-serif" role="img" aria-label="Sender encodes a message, it travels through a channel, receiver decodes it and sends feedback back">
        <rect x="18" y="46" width="108" height="58" rx="10" fill="#8b5cf6"/>
        <text x="72" y="70" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">SENDER</text>
        <text x="72" y="88" text-anchor="middle" font-size="10.5" fill="#ede9fe">has an idea</text>
        <line x1="131" y1="75" x2="177" y2="75" stroke="currentColor" stroke-width="2"/>
        <polygon points="185,75 174,70 174,80" fill="currentColor"/>
        <text x="158" y="64" text-anchor="middle" font-size="10.5" fill="currentColor" opacity="0.8">encode</text>
        <rect x="190" y="46" width="112" height="58" rx="10" fill="#3b82f6"/>
        <text x="246" y="70" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">MESSAGE</text>
        <text x="246" y="88" text-anchor="middle" font-size="10.5" fill="#dbeafe">call, text, email</text>
        <line x1="307" y1="75" x2="353" y2="75" stroke="currentColor" stroke-width="2"/>
        <polygon points="361,75 350,70 350,80" fill="currentColor"/>
        <text x="334" y="64" text-anchor="middle" font-size="10.5" fill="currentColor" opacity="0.8">decode</text>
        <rect x="366" y="46" width="106" height="58" rx="10" fill="#10b981"/>
        <text x="419" y="70" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">RECEIVER</text>
        <text x="419" y="88" text-anchor="middle" font-size="10.5" fill="#ecfdf5">understands</text>
        <path d="M 419 108 C 419 175 72 175 72 110" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-dasharray="6 4"/>
        <polygon points="72,102 67,112 77,112" fill="#f59e0b"/>
        <text x="246" y="163" text-anchor="middle" font-size="11.5" font-weight="600" fill="#f59e0b">FEEDBACK — "got it, thanks!"</text>
        <text x="240" y="212" text-anchor="middle" font-size="12" fill="currentColor" opacity="0.85">If any one arrow breaks, the message goes wrong.</text>
      </svg>`,

  "comm-flow": `<svg viewBox="0 0 460 220" font-family="Segoe UI, system-ui, sans-serif" role="img" aria-label="Manager at top with downward and upward arrows to you, and a horizontal arrow to a colleague">
