        <text x="230" y="183" text-anchor="middle" font-size="12" fill="currentColor" opacity="0.85">…so at least one box MUST get 2. That's the whole principle.</text>
      </svg>`,

  "m-dominoes": `<svg viewBox="0 0 470 185" font-family="Segoe UI, system-ui, sans-serif" role="img" aria-label="A line of dominoes where the first one falls and knocks all the others">
        <text x="235" y="20" text-anchor="middle" font-size="12.5" font-weight="600" fill="currentColor">Push the first one — and ALL of them fall</text>
        <text x="30" y="70" font-size="11.5" fill="#ef4444" font-weight="600">push!</text>
        <line x1="30" y1="80" x2="52" y2="92" stroke="#ef4444" stroke-width="2"/>
        <polygon points="60,96 48,96 53,86" fill="#ef4444"/>
        <rect x="70" y="60" width="17" height="72" rx="3" fill="#8b5cf6" transform="rotate(-38 78 132)"/>
        <rect x="130" y="60" width="17" height="72" rx="3" fill="#8b5cf6" transform="rotate(-20 138 132)"/>
        <rect x="190" y="60" width="17" height="72" rx="3" fill="#8b5cf6" transform="rotate(-8 198 132)"/>
        <rect x="250" y="60" width="17" height="72" rx="3" fill="#3b82f6"/>
        <rect x="310" y="60" width="17" height="72" rx="3" fill="#3b82f6"/>
        <rect x="370" y="60" width="17" height="72" rx="3" fill="#3b82f6"/>
        <line x1="55" y1="135" x2="420" y2="135" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
        <text x="235" y="167" text-anchor="middle" font-size="11.5" fill="currentColor" opacity="0.85">Step 1: first one falls. Step 2: each one knocks the next. Done!</text>
      </svg>`,

  "f-model": `<svg viewBox="0 0 480 205" font-family="Segoe UI, system-ui, sans-serif" role="img" aria-label="Input goes to CPU, CPU sends to output, and storage keeps data">
        <rect x="18" y="58" width="105" height="58" rx="10" fill="#60a5fa"/>
        <text x="70" y="82" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">INPUT</text>
        <text x="70" y="100" text-anchor="middle" font-size="10.5" fill="#eff6ff">keyboard, mouse</text>
        <line x1="128" y1="87" x2="172" y2="87" stroke="currentColor" stroke-width="2"/>
        <polygon points="180,87 169,82 169,92" fill="currentColor"/>
        <rect x="185" y="48" width="118" height="78" rx="10" fill="#2563eb"/>
        <text x="244" y="80" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">CPU</text>
        <text x="244" y="99" text-anchor="middle" font-size="10.5" fill="#dbeafe">thinks &amp; processes</text>
        <line x1="308" y1="87" x2="352" y2="87" stroke="currentColor" stroke-width="2"/>
        <polygon points="360,87 349,82 349,92" fill="currentColor"/>
        <rect x="365" y="58" width="100" height="58" rx="10" fill="#10b981"/>
        <text x="415" y="82" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff">OUTPUT</text>
        <text x="415" y="100" text-anchor="middle" font-size="10.5" fill="#ecfdf5">screen, printer</text>
        <line x1="228" y1="130" x2="228" y2="150" stroke="currentColor" stroke-width="2"/>
        <polygon points="228,157 223,148 233,148" fill="currentColor"/>
        <line x1="262" y1="150" x2="262" y2="130" stroke="currentColor" stroke-width="2"/>
        <polygon points="262,123 257,132 267,132" fill="currentColor"/>
        <rect x="185" y="158" width="118" height="40" rx="10" fill="none" stroke="currentColor" stroke-width="2"/>
        <text x="244" y="183" text-anchor="middle" font-size="12" font-weight="600" fill="currentColor">STORAGE</text>
        <text x="392" y="180" font-size="11" fill="currentColor" opacity="0.75">remembers</text>
        <text x="392" y="195" font-size="11" fill="currentColor" opacity="0.75">for later</text>
      </svg>`,

  "f-cpu": `<svg viewBox="0 0 470 235" font-family="Segoe UI, system-ui, sans-serif" role="img" aria-label="Inside the CPU: ALU, registers and control unit, connected by a bus to memory and input output">
        <rect x="20" y="28" width="232" height="148" rx="12" fill="none" stroke="currentColor" stroke-width="2.5"/>
        <text x="34" y="48" font-size="12.5" font-weight="700" fill="currentColor">CPU</text>
        <rect x="38" y="58" width="90" height="44" rx="8" fill="#ef4444"/>
        <text x="83" y="79" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">ALU</text>
        <text x="83" y="94" text-anchor="middle" font-size="10" fill="#fee2e2">does the maths</text>
        <rect x="144" y="58" width="92" height="44" rx="8" fill="#f59e0b"/>
        <text x="190" y="79" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">Registers</text>
        <text x="190" y="94" text-anchor="middle" font-size="10" fill="#fffbeb">tiny + fast</text>
        <rect x="38" y="114" width="198" height="44" rx="8" fill="#8b5cf6"/>
        <text x="137" y="135" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">Control Unit + Program Counter</text>
        <text x="137" y="150" text-anchor="middle" font-size="10" fill="#ede9fe">decides what runs next</text>
        <line x1="252" y1="102" x2="330" y2="102" stroke="currentColor" stroke-width="4" opacity="0.55"/>
        <text x="291" y="94" text-anchor="middle" font-size="11" font-weight="700" fill="currentColor">BUS</text>
        <line x1="330" y1="70" x2="330" y2="150" stroke="currentColor" stroke-width="4" opacity="0.55"/>
        <line x1="330" y1="70" x2="352" y2="70" stroke="currentColor" stroke-width="3" opacity="0.55"/>
        <line x1="330" y1="150" x2="352" y2="150" stroke="currentColor" stroke-width="3" opacity="0.55"/>
        <rect x="354" y="46" width="104" height="48" rx="8" fill="#3b82f6"/>
        <text x="406" y="68" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">MEMORY</text>
        <text x="406" y="83" text-anchor="middle" font-size="10" fill="#dbeafe">RAM</text>
        <rect x="354" y="126" width="104" height="48" rx="8" fill="none" stroke="currentColor" stroke-width="2"/>
        <text x="406" y="148" text-anchor="middle" font-size="11.5" font-weight="600" fill="currentColor">Input / Output</text>
        <text x="406" y="163" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.7">keyboard, screen</text>
        <text x="235" y="207" text-anchor="middle" font-size="12" fill="currentColor" opacity="0.85">The bus is the road — every piece of data travels on it.</text>
      </svg>`,

  "f-memory": `<svg viewBox="0 0 460 235" font-family="Segoe UI, system-ui, sans-serif" role="img" aria-label="Memory pyramid from fast small registers at top to big slow storage at bottom">
        <text x="230" y="20" text-anchor="middle" font-size="12.5" font-weight="600" fill="currentColor">Fast &amp; small on top, slow &amp; huge at the bottom</text>
        <polygon points="200,32 260,32 275,74 185,74" fill="#ef4444"/>
        <text x="230" y="59" text-anchor="middle" font-size="11.5" font-weight="600" fill="#fff">Registers</text>
