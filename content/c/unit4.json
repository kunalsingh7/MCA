      "code": "#include <stdio.h>\n\nstruct SData { int i; float f; char c; };   // separate memory\nunion  UData { int i; float f; char c; };   // shared memory\n\nenum Day { MON, TUE, WED, THU, FRI };       // MON=0, TUE=1, WED=2 ...\n\ntypedef struct {                            // typedef + structure\n    int  roll;\n    char name[20];\n} Student;                                  // new short type name\n\nint main() {\n    printf(\"struct = %zu bytes\\n\", sizeof(struct SData)); // 12 (with padding)\n    printf(\"union  = %zu bytes\\n\", sizeof(union UData));  // 4 (largest member)\n\n    union UData u;\n    u.i = 65;\n    printf(\"u.i = %d\\n\", u.i);      // 65\n    u.f = 3.5;                      // this OVERWRITES u.i\n    printf(\"u.f = %.1f\\n\", u.f);    // 3.5 - u.i is now garbage\n\n    enum Day today = WED;\n    printf(\"WED = %d\\n\", today);    // 2\n\n    Student s = {21, \"Asha\"};       // no need to write 'struct'\n    printf(\"%d %s\\n\", s.roll, s.name);\n    return 0;\n}",
