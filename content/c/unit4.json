      "code": "#include <stdio.h>\n#include <stdlib.h>      // for atoi()\n\nint main(int argc, char *argv[]) {\n    int x = 10;\n    int *p  = &x;        // pointer to int\n    int **q = &p;        // pointer to pointer\n\n    printf(\"%d %d %d\\n\", x, *p, **q);      // 10 10 10\n\n    char *names[3] = {\"Asha\", \"Ravi\", \"Neha\"};   // array of pointers\n    for (int i = 0; i < 3; i++)\n        printf(\"%s\\n\", names[i]);\n\n    printf(\"argc = %d\\n\", argc);                 // includes program name\n    for (int i = 0; i < argc; i++)\n        printf(\"argv[%d] = %s\\n\", i, argv[i]);\n\n    if (argc > 1)\n        printf(\"As a number: %d\\n\", atoi(argv[1]));  // string -> int\n    return 0;\n}",
